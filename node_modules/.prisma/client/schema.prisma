generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  STUDENT
  ALUMNI
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  ALUMNI
  INACTIVE
}

enum EnrollmentStatus {
  ENROLLED
  PROMOTED
  COMPLETED
  WITHDRAWN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      Student?
  alumni       Alumni?
}

model Student {
  id              String           @id @default(cuid())
  studentId       String           @unique
  firstName       String
  middleName      String?
  lastName        String
  dateOfBirth     DateTime?
  gender          String?
  email           String?
  phone           String?
  address         String?
  photoUrl        String?
  status          StudentStatus    @default(ACTIVE)
  userId          String?          @unique
  user            User?            @relation(fields: [userId], references: [id])
  enrollments     Enrollment[]
  academicRecords AcademicRecord[]
  alumni          Alumni?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Class {
  id            String   @id @default(cuid())
  name          String   @unique
  level         String?
  description   String?
  head          String?
  classTeacher  String?
  classPhotoUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments Enrollment[]
}

model Session {
  id              String           @id @default(cuid())
  name            String           @unique
  startDate       DateTime?
  endDate         DateTime?
  isCurrent       Boolean          @default(false)
  enrollments     Enrollment[]
  academicRecords AcademicRecord[]
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  classId   String
  sessionId String
  status    EnrollmentStatus @default(ENROLLED)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [classId], references: [id])
  session   Session          @relation(fields: [sessionId], references: [id])
  createdAt DateTime         @default(now())

  @@unique([studentId, sessionId])
}

model AcademicRecord {
  id         String   @id @default(cuid())
  studentId  String
  sessionId  String
  subject    String
  caScore    Float?
  examScore  Float?
  totalScore Float?
  grade      String?
  remark     String?
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session    Session  @relation(fields: [sessionId], references: [id])
  createdAt  DateTime @default(now())

  @@index([studentId, sessionId])
}

model Alumni {
  id              String          @id @default(cuid())
  studentId       String          @unique
  graduationYear  Int?
  graduationClass String?
  occupation      String?
  company         String?
  location        String?
  bio             String?
  photoUrl        String?
  isPublic        Boolean         @default(true)
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user            User?           @relation(fields: [userId], references: [id])
  userId          String?         @unique
  updateRequests  UpdateRequest[]
}

model UpdateRequest {
  id         String        @id @default(cuid())
  alumniId   String
  payload    Json
  status     RequestStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())
  alumni     Alumni        @relation(fields: [alumniId], references: [id], onDelete: Cascade)
}

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  imageUrl    String?
  publishedAt DateTime?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GalleryPhoto {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  head        String?
  createdAt   DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Almanac {
  id          String   @id @default(cuid())
  title       String
  year        Int
  description String?
  fileUrl     String?
  coverUrl    String?
  createdAt   DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
